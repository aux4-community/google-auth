{
  "scope": "community",
  "name": "google-auth",
  "version": "1.4.1",
  "description": "OAuth2 authentication for aux4 Google packages",
  "license": "MIT",
  "tags": [
    "google",
    "auth",
    "oauth",
    "google-workspace"
  ],
  "dependencies": [
    "aux4/curl",
    "aux4/json",
    "aux4/render"
  ],
  "system": [
    [
      "test:jq --version",
      "brew:jq",
      "linux:jq"
    ]
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "google",
          "execute": [
            "profile:google"
          ],
          "help": {
            "text": "Google commands"
          }
        }
      ]
    },
    {
      "name": "google",
      "commands": [
        {
          "name": "auth",
          "execute": [
            "profile:google:auth"
          ],
          "help": {
            "text": "Manage Google authentication"
          }
        },
        {
          "name": "services",
          "execute": [
            "profile:google:services"
          ],
          "help": {
            "text": "List available Google services"
          }
        }
      ]
    },
    {
      "name": "google:auth",
      "commands": [
        {
          "name": "login",
          "execute": [
            "when:${clientId}==:exit:1:No OAuth client id. Pass --clientId, or set GOOGLE_CLIENT_ID (a plain value or a secret:// reference). See the README section 'OAuth client setup'.",
            "json:aux4 google services list param(services) --json true | GOOGLE_AUTH_READONLY=value(readonly) jq '{scopes:(map(if env.GOOGLE_AUTH_READONLY == \"true\" then (if (.readonlyScope // \"\") == \"\" then .scope else .readonlyScope end) else .scope end) | map(split(\" \")) | flatten | . + [\"openid\", \"email\"] | map(select(. != \"\")) | unique | join(\" \")), names:(map(.name) | join(\", \")), missingReadonly:(map(select((.readonlyScope // \"\") == \"\") | .name) | join(\", \"))}'",
            "set:requested=$response",
            "when:${requested.names}==:exit:1:No Google service packages installed. Install one (for example community/google-drive) and try again.",
            "when:${readonly}==true && ${requested.missingReadonly}!=:log:These services do not declare a readonlyScope, so their full read-write scope was requested: ${requested.missingReadonly}",
            "# TODO(security): clientSecret is still passed on argv (visible via ps) through params(clientId,clientSecret). params() shell-escapes it (no injection), but moving the secret off argv entirely (env/stdin into aux4 curl oauth login) is a follow-up.",
            "aux4 curl oauth login google params(clientId,clientSecret) --authUrl 'https://accounts.google.com/o/oauth2/v2/auth?access_type=offline&prompt=consent&include_granted_scopes=true' --tokenUrl 'https://oauth2.googleapis.com/token' param(requested.scopes:scopes) param(tokenFile)",
            "nout:aux4 curl auth-request --provider google param(tokenFile) --url https://www.googleapis.com/oauth2/v3/userinfo >ignoreError | jq -sRr 'fromjson? | .email? // empty'",
            "set:account=$response",
            "when:${account}!=:log:Authenticated as ${account}",
            "when:${account}==:log:Authenticated. The account email could not be retrieved (the userinfo request returned nothing); this does not affect the token.",
            "log:Services: ${requested.names}",
            "log:Token file: ${tokenFile}"
          ],
          "help": {
            "text": "Authenticate with all installed Google services",
            "variables": [
              {
                "name": "services",
                "text": "Comma-separated services to authorize (default: all installed)",
                "default": ""
              },
              {
                "name": "readonly",
                "text": "Request read-only scopes where the service declares one",
                "default": "false"
              },
              {
                "name": "clientId",
                "text": "Google Cloud OAuth client id of a Desktop app client",
                "default": "",
                "env": "GOOGLE_CLIENT_ID"
              },
              {
                "name": "clientSecret",
                "text": "Google Cloud OAuth client secret of the same Desktop app client",
                "default": "",
                "env": "GOOGLE_CLIENT_SECRET",
                "hide": true
              },
              {
                "name": "tokenFile",
                "text": "Where the OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              }
            ]
          }
        },
        {
          "name": "status",
          "execute": [
            "aux4 curl oauth status google param(tokenFile)",
            "nout:aux4 curl auth-request --provider google param(tokenFile) --url https://www.googleapis.com/oauth2/v3/userinfo >ignoreError | jq -sRr 'fromjson? | .email? // empty'",
            "when:${response}!=:log:Account:       ${response}"
          ],
          "help": {
            "text": "Show current authentication status",
            "variables": [
              {
                "name": "tokenFile",
                "text": "Where the OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              }
            ]
          }
        },
        {
          "name": "logout",
          "execute": [
            "aux4 curl oauth logout google param(tokenFile)"
          ],
          "help": {
            "text": "Remove the stored Google OAuth token",
            "variables": [
              {
                "name": "tokenFile",
                "text": "Where the OAuth token is stored",
                "default": "${aux4HomeDir}/.oauth/google.json",
                "env": "AUX4_GOOGLE_TOKEN_FILE"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "google:services",
      "commands": [
        {
          "name": "list",
          "execute": [
            "when:${json}==true:aux4 google services scan param(services) | aux4 json collect",
            "when:${json}!=true:aux4 google services scan param(services) | aux4 json collect | aux4 render list --primary name --secondary description --badge scope"
          ],
          "help": {
            "text": "List available Google services from installed packages",
            "variables": [
              {
                "name": "services",
                "text": "Comma-separated services to list (default: all installed)",
                "default": ""
              },
              {
                "name": "json",
                "text": "Output as JSON",
                "default": "false",
                "hide": true
              }
            ]
          }
        },
        {
          "name": "scan",
          "private": true,
          "execute": [
            "set:ignoreErrors=true",
            "when:${services}==:json:aux4 google --json",
            "when:${services}==:each:aux4 google ${item.name} services >ignoreError",
            "when:${services}!=:nout:echo value(services) | tr ',' '\\n'",
            "when:${services}!=:each:aux4 google value(item) services >ignoreError"
          ],
          "help": {
            "text": "Emit the metadata of every resolvable Google service, one JSON object per line",
            "variables": [
              {
                "name": "services",
                "text": "Comma-separated services to scan (default: all installed)",
                "default": ""
              }
            ]
          }
        }
      ]
    }
  ]
}
